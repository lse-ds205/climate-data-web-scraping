# Virtual environments
group4venv/
local/
venv/
.venv/
logs/
.env

# Editor settings
.vscode/
.idea/

# JSON files (but allow entity management JSON files)
*.json
!data/entities/*.json

# Database files
*.db
*.sqlite
*.sqlite3

# Dataframes and data files
*.pkl
*.parquet
*.csv
*.h5
*.feather
*.npz
*.npy
*.xlsx

# Data folder - contains PDFs (but allow entity management files)
# Note: exceptions must come before the general rule
!data/entities/
!data/entities/*.json
data/*
!data/entities

# Logs - ignore all log files and log directories anywhere in the project
logs/
**/logs/
*.log
**/*.log

# Local models folder
local_models/
outputs/

# Python cache files - ignore all pycache directories anywhere in the project
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS specific files
.DS_Store
Thumbs.db

# Docker data (local development only)
.docker-data/